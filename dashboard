<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Room Availability Dashboard</title>

<style>
body {
  margin: 0;
  font-family: 'Segoe UI', sans-serif;
  background: #f4f6f9;
}

/* TOP BAR */
.topbar {
  background: #2e7d32;
  padding: 15px;
  display: flex;
  justify-content: center;
}

.topbar form {
  display: flex;
  gap: 15px;
}

.topbar input {
  padding: 10px;
  border-radius: 6px;
  border: none;
}

.search-input { width: 250px; }
.time-input { width: 150px; }

.topbar button {
  padding: 10px 18px;
  background: #1b5e20;
  color: white;
  border: none;
  border-radius: 6px;
  cursor: pointer;
}

.topbar button:hover {
  background: #144d17;
}

/* LAYOUT */
.container {
  display: flex;
  height: calc(100vh - 60px);
}

/* SIDEBAR */
.sidebar {
  width: 260px;
  background: white;
  padding: 20px;
  border-right: 1px solid #ddd;
}

.sidebar h3 {
  color: #2e7d32;
}

.placeholder {
  background: #e8f5e9;
  padding: 12px;
  margin-top: 10px;
  border-radius: 6px;
}

/* MAIN */
.main {
  flex: 1;
  padding: 30px;
  position: relative;
}

/* TABLE */
table {
  width: 100%;
  border-collapse: collapse;
  background: white;
  border-radius: 10px;
  overflow: hidden;
}

th, td {
  padding: 12px;
  border-bottom: 1px solid #ddd;
  text-align: center;
}

th {
  background: #2e7d32;
  color: white;
}

/* STATUS */
.available { color: green; font-weight: bold; }
.occupied { color: red; font-weight: bold; }

/* HELP BUTTON (BOTTOM) */
.help-bottom {
  position: absolute;
  bottom: 70px;
  right: 20px;
  background: white;
  color: #2e7d32;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  border: none;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

/* LOGOUT */
.logout {
  position: absolute;
  bottom: 20px;
  right: 20px;
  background: #c62828;
  color: white;
  padding: 10px 15px;
  border-radius: 6px;
  text-decoration: none;
}

/* MODAL */
.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
}

.modal-content {
  background: white;
  width: 400px;
  margin: 100px auto;
  padding: 20px;
  border-radius: 10px;
  text-align: center;
}

.close-btn {
  float: right;
  cursor: pointer;
  font-size: 18px;
}
</style>
</head>

<body>

<!-- TOP SEARCH -->
<div class="topbar">
  <form>
    <input type="text" placeholder="Enter Room Number..." class="search-input" required>
    <input type="time" class="time-input" required>
    <button type="submit">Search</button>
  </form>
</div>

<!-- MAIN -->
<div class="container">

  <!-- SIDEBAR -->
  <div class="sidebar">
    <h3>📢 Special Occurrences</h3>
    <div class="placeholder">Data will be fetched from database</div>
    <a href="edit.html">Edit Updates</a>
  </div>

  <!-- MAIN CONTENT -->
  <div class="main">

    <!-- TABLE -->
    <table>
      <tr>
        <th>Room</th>
        <th>Time</th>
        <th>Status</th>
        <th>Faculty</th>
      </tr>
      <tr>
        <td>A101</td>
        <td>10:30</td>
        <td class="occupied">Occupied</td>
        <td>Dr. Sharma</td>
      </tr>
      <tr>
        <td>B202</td>
        <td>11:00</td>
        <td class="available">Available</td>
        <td>-</td>
      </tr>
    </table>

    <!-- HELP BUTTON -->
    <button class="help-bottom" onclick="openHelp()">?</button>

    <!-- LOGOUT -->
    <a href="login.html" class="logout">Logout</a>

  </div>

</div>

<!-- HELP MODAL -->
<div id="helpModal" class="modal">
  <div class="modal-content">
    <span class="close-btn" onclick="closeHelp()">❌</span>
    <h3>Help</h3>
    <p>1. Enter room number</p>
    <p>2. Select time</p>
    <p>3. Click search</p>
    <p>Check table for availability and faculty info.</p>
  </div>
</div>

<script>
function openHelp() {
  document.getElementById("helpModal").style.display = "block";
}

function closeHelp() {
  document.getElementById("helpModal").style.display = "none";
}
</script>

</body>
</html>
